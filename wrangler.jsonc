{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boden-lanesystem",
  "main": "worker.js",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boden-db"
    }
  ]
}
